rules_version = '2';

// Regras de segurança do Firestore
// (Console Firebase > Firestore Database > Regras > colar e publicar)
//
// Cada usuário só pode ler e gravar o que está dentro do seu próprio
// documento: usuarios/{uid} e tudo abaixo dele (pets, agendamentos...).
// Sem login, nada é permitido.
service cloud.firestore {
  match /databases/{database}/documents {
    match /usuarios/{usuarioId}/{documento=**} {
      allow read, write: if request.auth != null && request.auth.uid == usuarioId;
    }
  }
}
